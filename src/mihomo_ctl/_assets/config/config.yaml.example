# 最小可运行 mihomo 配置(无节点)
# - 启动后所有流量走 DIRECT (不走代理),用于在没拉订阅时验证 web UI/API 能起来
# - 一旦你 mhctl sub <URL> 拉了订阅,此文件会被订阅的 config.yaml 覆盖

mixed-port: 17890
external-controller: 0.0.0.0:9090
external-ui: ui
secret: "mypassword123"
allow-lan: false
bind-address: '*'
mode: rule
log-level: info
ipv6: false
unified-delay: true
tcp-concurrent: true

dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  nameserver:
    - 223.5.5.5
    - 119.29.29.29

proxies: []

proxy-groups:
  - name: 🚀节点选择
    type: select
    proxies:
      - DIRECT

rules:
  - MATCH,DIRECT
